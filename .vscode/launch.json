{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "personal-website",
            "request": "launch",
            "type": "dart",
            "args": [
                "-d",
                "chrome",
                "--web-browser-flag=--disable-service-worker",
                "--web-browser-flag=--disable-cache"
            ]
        },
        {
            "name": "personal-website (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": [
                "-d",
                "chrome",
                "--web-browser-flag=--disable-service-worker"
            ]
        },
        {
            "name": "personal-website (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}

